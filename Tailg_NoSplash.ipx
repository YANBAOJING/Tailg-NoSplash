#!name = Tailg NoSplash
#!desc = 通过修改台铃智能 App 的配置响应关闭开屏广告
#!author = Loon
#!homepage = https://github.com/YANBAOJING/Tailg-NoSplash
#!icon = https://raw.githubusercontent.com/YANBAOJING/Tailg-NoSplash/main/IMG_2735.png
#!system = iOS,iPadOS,tvOS,macOS
#!system_version = 15
#!loon_version = 3.5.1(978)
#!tag = 台铃,工具
#!type = normal

[Argument]
name = input,"Loon",tag=名称,desc=输入一个名称
region = select,"CN","US","JP",tag=地区
enabled = switch,true,tag=启用

[General]
bypass-tun =
skip-proxy =
real-ip =
dns-server =

[Rule]

[Rewrite]

[Host]

[Script]
http-response ^https?:\/\/www\.tailgdd\.com\/v8\/smart\/app\/config\/get script-path=https://raw.githubusercontent.com/YANBAOJING/Tailg-NoSplash/main/tailg_nosplash.js,requires-body=true,tag=Tailg去开屏广告

[Mitm]
hostname = www.tailgdd.com
