<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Tailg NoSplash</string>
  <key>description</key>
  <string>Disable Tailg (台铃智能) app splash/open-screen ads by modifying the app config response.</string>
  <key>icon</key>
  <string>https://raw.githubusercontent.com/YANBAOJING/Tailg-NoSplash/main/icon.png</string>
  <key>scripts</key>
  <array>
    <dict>
      <key>type</key>
      <string>response</string>
      <key>name</key>
      <string>tailg_nosplash.js</string>
      <key>url</key>
      <string>https://raw.githubusercontent.com/YANBAOJING/Tailg-NoSplash/main/tailg_nosplash.js</string>
      <key>pattern</key>
      <array>
        <string>^https?:\/\/www\.tailgdd\.com\/v8\/smart\/app\/config\/get</string>
      </array>
      <key>hostname</key>
      <array>
        <string>www.tailgdd.com</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
